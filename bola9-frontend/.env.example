# ==========================================
# Frontend - Variables de Entorno
# ==========================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env

# ==========================================
# ENTORNO DE DESARROLLO (Local y Ngrok)
# ==========================================
# No definimos VITE_API_URL.
# Al no existir, api.js usará '' y el Proxy de vite.config.js hará la magia.
# VITE_API_URL=

# ==========================================
# ENTORNO DE PRODUCCIÓN (Cuando subas a un Hosting)
# ==========================================
# Descomenta esta línea cuando hagas el "npm run build"
# VITE_API_URL=https://api.tudominio.cl
